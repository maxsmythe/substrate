# Worker pool for the benchmark workloads. The ActorTemplates are not CRDs:
# they live in the *-template.yaml.tmpl files next to this one and are
# created through the ate API by workloads/deploy.sh with
# `kubectl ate create actor-template`.

apiVersion: v1
kind: Namespace
metadata:
  name: benchmark-workloads

---

apiVersion: ate.dev/v1alpha1
kind: WorkerPool
metadata:
  name: benchmark-ateom
  namespace: benchmark-workloads
  labels:
    workload: benchmark-ateom
spec:
  replicas: ${WORKER_COUNT}
  sandboxClass: ${SANDBOX_CLASS}
  workerImage: ko://github.com/agent-substrate/substrate/cmd/ateom-${SANDBOX_CLASS}
  template:
    # The actor sandbox runs inside the worker pod, so this request is what
    # the scheduler counts per hosted actor. No limit: the actor's own
    # resources.limits.memory bounds the sandbox, and a pod limit on top
    # would only add a second OOM boundary. See deploy.sh --worker-memory-request.
    resources:
      requests:
        memory: ${WORKER_MEMORY_REQUEST}
